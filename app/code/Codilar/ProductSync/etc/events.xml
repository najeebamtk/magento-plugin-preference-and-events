<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Runs after any product is saved (we filter "new only" inside the observer) -->
    <event name="catalog_product_save_after">
        <observer name="codilar_product_sync_on_create"
                  instance="Codilar\ProductSync\Observer\ProductCreated"/>
    </event>
</config>
