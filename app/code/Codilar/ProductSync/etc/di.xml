<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- 1. Handler: decides WHERE logs are written -> var/log/product_sync.log -->
    <virtualType name="Codilar\ProductSync\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/product_sync.log</argument>
        </arguments>
    </virtualType>

    <!-- 2. Logger: the object we call ->info() / ->error() on, using the handler above -->
    <virtualType name="Codilar\ProductSync\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">productSync</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Codilar\ProductSync\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- 3. Give our logger to the observer (instead of the default system.log logger) -->
    <type name="Codilar\ProductSync\Observer\ProductCreated">
        <arguments>
            <argument name="logger" xsi:type="object">Codilar\ProductSync\Logger</argument>
        </arguments>
    </type>

    <!-- 4. Same logger for the consumer, so every API attempt is logged -->
    <type name="Codilar\ProductSync\Model\Consumer">
        <arguments>
            <argument name="logger" xsi:type="object">Codilar\ProductSync\Logger</argument>
        </arguments>
    </type>
</config>
