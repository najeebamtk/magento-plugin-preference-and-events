<?php
/** @var \Codilar\School\Block\School $block */
$schools = $block->getSchools();
?>
<div class="school-page">
    <div class="school-header">
        <div>
            <h1 class="school-title">Schools</h1>
            <p class="school-subtitle"><?= (int) $schools->getSize() ?> saved</p>
        </div>
        <a class="school-button" href="<?= $block->escapeUrl($block->getUrl('school/school/index')) ?>">+ Add school</a>
    </div>

    <?php if ($schools->getSize() === 0): ?>
        <div class="school-empty">
            <p>No schools yet.</p>
            <a class="school-link" href="<?= $block->escapeUrl($block->getUrl('school/school/index')) ?>">Add the first one</a>
        </div>
    <?php else: ?>
        <div class="school-grid">
            <?php foreach ($schools as $school): ?>
                <article class="school-item">
                    <div class="school-logo">
                        <?php $logoUrl = $block->getLogoUrl($school->getLogo()); ?>
                        <?php if ($logoUrl): ?>
                            <img src="<?= $block->escapeUrl($logoUrl) ?>" alt="<?= $block->escapeHtmlAttr($school->getName()) ?> logo" loading="lazy">
                        <?php else: ?>
                            <span class="school-logo-placeholder" aria-hidden="true">
                                <?= $block->escapeHtml(mb_strtoupper(mb_substr($school->getName(), 0, 1))) ?>
                            </span>
                        <?php endif; ?>
                    </div>
                    <h2 class="school-item-name"><?= $block->escapeHtml($school->getName()) ?></h2>
                    <div class="school-badges">
                        <span class="school-badge school-badge-code"><?= $block->escapeHtml($school->getCode()) ?></span>
                        <?php if ($school->getCity()): ?>
                            <span class="school-badge school-badge-city"><?= $block->escapeHtml($school->getCity()) ?></span>
                        <?php endif; ?>
                    </div>
                </article>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</div>
