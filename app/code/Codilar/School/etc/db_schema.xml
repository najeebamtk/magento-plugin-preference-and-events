<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="codilar_school" resource="default" engine="innodb" comment="Schools">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="name" length="255" nullable="false" comment="School name"/>
        <column xsi:type="varchar" name="code" length="64" nullable="false" comment="School code"/>
        <column xsi:type="varchar" name="city" length="255" nullable="true" comment="City"/>
        <column xsi:type="varchar" name="logo" length="255" nullable="true" comment="Logo image path"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="CODILAR_SCHOOL_CODE">
            <column name="code"/>
        </constraint>
    </table>
</schema>
