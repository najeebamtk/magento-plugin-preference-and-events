<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <!-- Shown in System > Permissions > User Roles > Role Resources -->
                <resource id="Codilar_ReturnManagement::returns" title="Return Management" translate="title" sortOrder="35">
                    <resource id="Codilar_ReturnManagement::requests" title="Return Requests" translate="title" sortOrder="10">
                        <resource id="Codilar_ReturnManagement::request_save" title="Update Status" translate="title" sortOrder="10"/>
                        <resource id="Codilar_ReturnManagement::request_create" title="Add Return" translate="title" sortOrder="20"/>
                    </resource>
                </resource>
                <!-- Permission to open Stores > Configuration > Codilar > Return Management -->
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Codilar_ReturnManagement::config" title="Return Management Settings" translate="title" sortOrder="100"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
