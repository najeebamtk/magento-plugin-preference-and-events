<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Tells the UI grid which collection gives the rows for our data source name -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="codilar_return_request_listing_data_source" xsi:type="string">Codilar\ReturnManagement\Model\ResourceModel\ReturnRequest\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
</config>
