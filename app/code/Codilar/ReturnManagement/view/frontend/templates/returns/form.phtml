<?php
/** @var \Codilar\ReturnManagement\Block\Returns $block */
/** @var \Magento\Framework\Escaper $escaper */

$order = $block->getOrder();
$deadline = $block->getReturnDeadline();
?>
<div class="block">
    <div class="block-title"><strong><?= $escaper->escapeHtml(__('Items to Return')) ?></strong></div>
    <div class="block-content">
        <p>
            <?= $escaper->escapeHtml(__('Order #%1 placed on %2.', $order->getIncrementId(), $block->formatDate($order->getCreatedAt()))) ?>
            <?php if ($deadline): ?>
                <?= $escaper->escapeHtml(__('Return period ends on %1.', $block->formatDate($deadline))) ?>
            <?php endif; ?>
        </p>
        <p><?= $escaper->escapeHtml(__('In this version the whole order is returned.')) ?></p>
        <div class="table-wrapper">
            <table class="data table">
                <thead>
                    <tr>
                        <th scope="col"><?= $escaper->escapeHtml(__('Product Name')) ?></th>
                        <th scope="col"><?= $escaper->escapeHtml(__('SKU')) ?></th>
                        <th scope="col"><?= $escaper->escapeHtml(__('Qty')) ?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($block->getReturnItems() as $item): ?>
                        <tr>
                            <td><?= $escaper->escapeHtml($item['product_name']) ?></td>
                            <td><?= $escaper->escapeHtml($item['product_sku']) ?></td>
                            <td><?= (float) $item['qty_requested'] ?></td>
                        </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        </div>
    </div>
</div>

<form class="form" method="post" action="<?= $escaper->escapeUrl($block->getSubmitUrl()) ?>">
    <?= $block->getBlockHtml('formkey') ?>
    <!-- Only the order ID is sent. The customer ID is taken from the session on the server. -->
    <input type="hidden" name="order_id" value="<?= (int) $order->getId() ?>"/>

    <fieldset class="fieldset">
        <div class="field required">
            <label class="label" for="return-reason"><span><?= $escaper->escapeHtml(__('Reason')) ?></span></label>
            <div class="control">
                <select id="return-reason" name="reason" required>
                    <option value=""><?= $escaper->escapeHtml(__('-- Please select --')) ?></option>
                    <?php foreach ($block->getReasons() as $value => $label): ?>
                        <option value="<?= $escaper->escapeHtmlAttr($value) ?>"><?= $escaper->escapeHtml($label) ?></option>
                    <?php endforeach; ?>
                </select>
            </div>
        </div>
        <div class="field">
            <label class="label" for="return-comments"><span><?= $escaper->escapeHtml(__('Comments (optional)')) ?></span></label>
            <div class="control">
                <textarea id="return-comments" name="comments" rows="4"></textarea>
            </div>
        </div>
    </fieldset>

    <div class="actions-toolbar">
        <div class="primary">
            <button type="submit" class="action submit primary"><span><?= $escaper->escapeHtml(__('Submit Return Request')) ?></span></button>
        </div>
        <div class="secondary">
            <a class="action back" href="<?= $escaper->escapeUrl($block->getBackUrl()) ?>"><span><?= $escaper->escapeHtml(__('Back')) ?></span></a>
        </div>
    </div>
</form>
