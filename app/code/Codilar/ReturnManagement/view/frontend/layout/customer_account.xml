<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Adds "My Returns" to the My Account sidebar (higher sortOrder = higher in the list; My Orders is 230) -->
        <!-- ifconfig: the link is only added when Enable Module = Yes -->
        <referenceBlock name="customer_account_navigation">
            <block class="Magento\Customer\Block\Account\SortLinkInterface" name="customer-account-navigation-returns-link"
                   ifconfig="return_management/general/enabled">
                <arguments>
                    <argument name="path" xsi:type="string">returns/index/index</argument>
                    <argument name="label" xsi:type="string" translate="true">My Returns</argument>
                    <argument name="sortOrder" xsi:type="number">225</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
