// AJAX: customer changes => ask the Orders controller for that customer's orders => rebuild the order dropdown.
// $secureRenderer adds the CSP nonce so the admin's Content Security Policy allows this inline script.
$ordersUrl = $escaper->escapeJs($block->getOrdersUrl());
$loadingText = $escaper->escapeJs(__('Loading orders...'));
$selectText = $escaper->escapeJs(__('-- Please select --'));
$firstText = $escaper->escapeJs(__('-- Select a customer first --'));
$noneText = $escaper->escapeJs(__('This customer has no orders.'));
$script = <<<JS
require(['jquery'], function ($) {
    var orderSelect = $('#return-order');

    function setPlaceholder(text) {
        orderSelect.empty().append($('<option>').val('').text(text));
    }

    $('#return-customer').on('change', function () {
        var customerId = $(this).val();

        orderSelect.prop('disabled', true);
        if (!customerId) {
            setPlaceholder('{$firstText}');
            return;
        }
        setPlaceholder('{$loadingText}');

        $.ajax({
            url: '{$ordersUrl}',
            type: 'GET',
            dataType: 'json',
            data: {customer_id: customerId, isAjax: true}
        }).done(function (response) {
            if (!response.orders.length) {
                setPlaceholder('{$noneText}');
                return;
            }
            setPlaceholder('{$selectText}');
            $.each(response.orders, function (i, order) {
                // .text() (not .html()) so order data is never treated as HTML
                orderSelect.append($('<option>').val(order.value).text(order.label).prop('disabled', order.disabled));
            });
            orderSelect.prop('disabled', false);
        });
    });
});
JS;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $script, false) ?>
