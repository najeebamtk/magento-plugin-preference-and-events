<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">codilar_return_request_listing.codilar_return_request_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <!-- "Add Return" button at the top right, like "Add Product" -->
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add Return</label>
            </button>
        </buttons>
        <spinner>codilar_return_request_columns</spinner>
        <deps>
            <dep>codilar_return_request_listing.codilar_return_request_listing_data_source</dep>
        </deps>
    </settings>

    <!-- Where the rows come from: this name is mapped to our Grid\Collection in etc/di.xml -->
    <dataSource name="codilar_return_request_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">request_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Codilar_ReturnManagement::requests</aclResource>
        <dataProvider class="Codilar\ReturnManagement\Ui\DataProvider\ReturnRequestDataProvider" name="codilar_return_request_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>request_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <!-- Toolbar above the grid: saved views, column chooser, filters, pagination -->
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <!-- "Search by keyword" box -->
        <filterSearch name="fulltext"/>
        <!-- Export dropdown: CSV and Excel XML -->
        <exportButton name="export_button"/>
        <!-- "Actions" dropdown for the ticked rows -->
        <massaction name="listing_massaction">
            <action name="change_status">
                <settings>
                    <type>change_status</type>
                    <label translate="true">Change Status</label>
                    <actions>
                        <action name="0">
                            <type>pending</type>
                            <label translate="true">Pending</label>
                            <url path="returnmanagement/request/massStatus">
                                <param name="status">pending</param>
                            </url>
                        </action>
                        <action name="1">
                            <type>approved</type>
                            <label translate="true">Approved</label>
                            <url path="returnmanagement/request/massStatus">
                                <param name="status">approved</param>
                            </url>
                        </action>
                        <action name="2">
                            <type>rejected</type>
                            <label translate="true">Rejected</label>
                            <url path="returnmanagement/request/massStatus">
                                <param name="status">rejected</param>
                            </url>
                        </action>
                        <action name="3">
                            <type>completed</type>
                            <label translate="true">Completed</label>
                            <url path="returnmanagement/request/massStatus">
                                <param name="status">completed</param>
                            </url>
                        </action>
                    </actions>
                </settings>
            </action>
        </massaction>
        <filters name="listing_filters">
            <!-- "Store View" dropdown in the Filters panel only (no grid column), like the product grid -->
            <filterSelect name="store_id" provider="${ $.parentName }">
                <settings>
                    <options class="Magento\Store\Ui\Component\Listing\Column\Store\Options"/>
                    <!-- Empty first choice. Without it, "Clear all" picks the first store view instead of clearing -->
                    <caption translate="true">All Store Views</caption>
                    <label translate="true">Store View</label>
                    <dataScope>store_id</dataScope>
                </settings>
            </filterSelect>
        </filters>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="codilar_return_request_columns">
        <!-- First column: checkboxes with the select-all dropdown, like the product grid -->
        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>request_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="request_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Request ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="increment_id" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Order #</label>
            </settings>
        </column>
        <column name="customer_name" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Customer Name</label>
            </settings>
        </column>
        <column name="customer_email" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Customer Email</label>
            </settings>
        </column>
        <column name="reason" component="Magento_Ui/js/grid/columns/select" sortOrder="50">
            <settings>
                <options class="Codilar\ReturnManagement\Model\Source\Reason"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Reason</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="60">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Request Date</label>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select" sortOrder="70">
            <settings>
                <options class="Codilar\ReturnManagement\Model\Source\Status"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="order_status" component="Magento_Ui/js/grid/columns/select" sortOrder="75">
            <settings>
                <options class="Magento\Sales\Ui\Component\Listing\Column\Status\Options"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Order Status</label>
            </settings>
        </column>
        <column name="website_id" component="Magento_Ui/js/grid/columns/select" sortOrder="80">
            <settings>
                <options class="Codilar\ReturnManagement\Model\Source\Website"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Website</label>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="90">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Last Updated</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Codilar\ReturnManagement\Ui\Component\Listing\Column\Actions" sortOrder="100">
            <settings>
                <indexField>request_id</indexField>
                <label translate="true">Action</label>
            </settings>
        </actionsColumn>
    </columns>
</listing>
