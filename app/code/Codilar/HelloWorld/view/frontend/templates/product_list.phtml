<div class="product-list-page">
    <?php $products = $block->getProducts(); ?>

    <div class="product-header">
        <div>
            <h1 class="product-title">Products</h1>
            <p class="product-subtitle"><?= (int) $products->getSize() ?> saved</p>
        </div>
        <a class="product-button" href="<?= $block->escapeUrl($block->getUrl('hello/product/index')) ?>">+ Add Product</a>
    </div>

    <?php if ($products->getSize() === 0): ?>
        <div class="product-empty">
            <p>No products have been added yet.</p>
            <a class="product-link" href="<?= $block->escapeUrl($block->getUrl('hello/product/index')) ?>">Add the first one</a>
        </div>
    <?php else: ?>
        <div class="product-grid">
            <?php foreach ($products as $product): ?>
                <article class="product-item">
                    <div class="product-image">
                        <?php if ($product->getImage()): ?>
                            <img src="<?= $block->escapeUrl($block->getImageUrl($product->getImage())) ?>"
                                 alt="<?= $block->escapeHtmlAttr($product->getName()) ?>"
                                 loading="lazy">
                        <?php else: ?>
                            <span class="product-image-placeholder" aria-hidden="true">
                                <?= $block->escapeHtml(mb_strtoupper(mb_substr($product->getName(), 0, 1))) ?>
                            </span>
                        <?php endif; ?>
                    </div>
                    <h2 class="product-item-name"><?= $block->escapeHtml($product->getName()) ?></h2>
                    <div class="product-badges">
                        <span class="product-badge product-badge-sku"><?= $block->escapeHtml($product->getSku()) ?></span>
                        <span class="product-badge product-badge-price">$<?= number_format((float) $product->getPrice(), 2) ?></span>
                    </div>
                </article>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</div>
