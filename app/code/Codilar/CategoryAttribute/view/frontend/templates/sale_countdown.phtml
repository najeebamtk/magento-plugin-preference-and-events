<?php $script = <<<JS
(function () {
    var box = document.getElementById('sale-float');
    var end = parseInt(box.dataset.end, 10) * 1000;
    var nums = {};
    box.querySelectorAll('.sale-float__num').forEach(function (el) {
        nums[el.dataset.unit] = el;
    });
    var bubbleTime = box.querySelector('.sale-float__bubble-time');
    var badgeText = box.querySelector('.sale-float__badge-text');
    var storageKey = 'saleFloatMinimised';

    function setMinimised(min) {
        box.classList.toggle('is-min', min);
        try {
            sessionStorage.setItem(storageKey, min ? '1' : '0');
        } catch (e) {}
    }

    try {
        if (sessionStorage.getItem(storageKey) === '1') {
            box.classList.add('is-min');
        }
    } catch (e) {}

    box.querySelector('.sale-float__min').addEventListener('click', function () {
        setMinimised(true);
    });
    box.querySelector('.sale-float__bubble').addEventListener('click', function () {
        setMinimised(false);
    });

    function pad(n) {
        return n < 10 ? '0' + n : String(n);
    }

    function show(unit, value) {
        var el = nums[unit];
        var text = pad(value);
        if (el.textContent !== text) {
            el.textContent = text;
            el.classList.remove('is-tick');
            void el.offsetWidth;
            el.classList.add('is-tick');
        }
    }

    function tick() {
        var left = end - Date.now();
        if (left <= 0) {
            box.style.display = 'none';
            return;
        }
        var d = Math.floor(left / 86400000);
        var h = Math.floor(left / 3600000) % 24;
        var m = Math.floor(left / 60000) % 60;
        var s = Math.floor(left / 1000) % 60;

        show('d', d);
        show('h', h);
        show('m', m);
        show('s', s);
        bubbleTime.textContent = d > 0 ? d + 'd ' + h + 'h' : pad(h) + ':' + pad(m) + ':' + pad(s);

        if (left < 86400000 && !box.classList.contains('is-urgent')) {
            box.classList.add('is-urgent');
            badgeText.textContent = box.dataset.urgentLabel;
        }
        setTimeout(tick, 1000);
    }
    tick();
})();
JS;
